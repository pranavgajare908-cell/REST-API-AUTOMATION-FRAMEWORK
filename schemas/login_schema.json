{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Login API Response",
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "tokenType",
        "accessToken",
        "refreshToken",
        "expiresIn",
        "user"
      ],
      "properties": {
        "tokenType": {
          "type": "string"
        },
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "type": "string"
        },
        "expiresIn": {
          "type": "integer"
        },
        "user": {
          "type": "object",
          "required": [
            "id",
            "email",
            "name",
            "role"
          ],
          "properties": {
            "id": {
              "type": "integer"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "name": {
              "type": "string"
            },
            "role": {
              "type": "string"
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "requestId",
        "responseTimeMs",
        "timestamp",
        "apiVersion"
      ],
      "properties": {
        "requestId": {
          "type": "string"
        },
        "responseTimeMs": {
          "type": "number"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "apiVersion": {
          "type": "string"
        }
      }
    }
  }
}