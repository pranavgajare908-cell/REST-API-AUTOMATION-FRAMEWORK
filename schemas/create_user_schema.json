{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Create User API Response",
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "role",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "role": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "requestId",
        "responseTimeMs",
        "timestamp",
        "apiVersion"
      ],
      "properties": {
        "requestId": {
          "type": "string"
        },
        "responseTimeMs": {
          "type": "number"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "apiVersion": {
          "type": "string"
        }
      }
    }
  }
}