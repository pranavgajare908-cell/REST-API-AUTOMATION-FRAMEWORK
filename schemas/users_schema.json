{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Users API Response",
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "firstName",
          "lastName",
          "username",
          "email",
          "role",
          "status",
          "avatar",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "requestId",
        "responseTimeMs",
        "timestamp",
        "apiVersion"
      ],
      "properties": {
        "requestId": {
          "type": "string"
        },
        "responseTimeMs": {
          "type": "number"
        },
        "timestamp": {
          "type": "string"
        },
        "apiVersion": {
          "type": "string"
        }
      }
    }
  }
}